default_platform(:ios)

# TestFlight for the copad iOS app, modeled on ~/dev/aide/ios/fastlane. Uses the App Store
# Connect API key, so no Apple ID login. Run through copad-ios/scripts/testflight.sh (locally or
# in .github/workflows/testflight.yml); CI passes the key through the APP_STORE_CONNECT_* env.
APP_ID   = "com.marshall.copad.ios"
TEAM_ID  = "8QNJMX7JJ2"
KEY_ID   = ENV.fetch("APP_STORE_CONNECT_KEY_ID", "46AYC5A487")
ISSUER   = ENV.fetch("APP_STORE_CONNECT_ISSUER_ID", "9cf136f0-5d38-441e-bed9-68fd87649ecf")
KEY_PATH = ENV.fetch("APP_STORE_CONNECT_KEY_PATH",
                     File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{KEY_ID}.p8"))
OUT      = File.expand_path("../build/fastlane", __dir__)

def asc_key
  app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER, key_filepath: KEY_PATH)
end

def connect_api
  require "spaceship"
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: KEY_ID, issuer_id: ISSUER, filepath: KEY_PATH,
  )
end

platform :ios do
  # Registers the bundle ID if missing and enables Push Notifications on it (comux pushes
  # agent turns over APNs). Apple invalidates existing profiles when a capability changes, so
  # `beta` regenerates them then. The App Store Connect app record itself cannot be created with
  # an API key: create it once at appstoreconnect.apple.com before running `beta`.
  lane :register do
    connect_api
    bundle = Spaceship::ConnectAPI::BundleId.all.find { |b| b.identifier == APP_ID }
    if bundle
      UI.message("Bundle ID #{APP_ID} already registered")
    else
      bundle = Spaceship::ConnectAPI::BundleId.create(name: "copad", identifier: APP_ID, platform: "IOS")
      UI.success("Registered bundle ID #{APP_ID}")
    end
    push = Spaceship::ConnectAPI::BundleIdCapability::Type::PUSH_NOTIFICATIONS
    if bundle.get_capabilities.any? { |c| c.capability_type == push }
      UI.message("Push Notifications already enabled")
    else
      bundle.create_capability(push)
      UI.success("Enabled Push Notifications on #{APP_ID}")
      @capabilities_changed = true
    end
  end

  # Archive with the distribution identity and upload to TestFlight (build number = latest + 1,
  # 1 for the first build). `upload:false` builds build/fastlane/copad.ipa only — it needs no
  # App Store Connect record, so it also proves signing before the record exists.
  lane :beta do |options|
    upload = options[:upload] != false
    key = asc_key
    register

    Dir.chdir("..") { sh("xcodegen", "generate") }
    version = options[:version].to_s.delete_prefix("v")
    UI.user_error!("version must be X.Y.Z") unless version.empty? || version.match?(/\A\d+\.\d+\.\d+\z/)
    build_number = if upload
      latest_testflight_build_number(api_key: key, app_identifier: APP_ID, initial_build_number: 0) + 1
    else
      1
    end

    get_provisioning_profile(app_identifier: APP_ID, api_key: key, output_path: OUT, force: @capabilities_changed == true)
    profile_name = lane_context[SharedValues::SIGH_NAME]

    # Signing goes on the app target only: as xcargs it would reach the Swift packages'
    # targets, which refuse a provisioning profile.
    update_code_signing_settings(
      path: "copad-ios.xcodeproj",
      targets: ["copad-ios"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
    )

    build_app(
      project: "copad-ios.xcodeproj",
      scheme: "copad-ios",
      configuration: "Release",
      export_method: "app-store",
      output_directory: OUT,
      output_name: "copad.ipa",
      export_options: {
        signingStyle: "manual",
        provisioningProfiles: { APP_ID => profile_name },
      },
      xcargs: [
        "-skipPackagePluginValidation",
        "CURRENT_PROJECT_VERSION=#{build_number}",
        (version.empty? ? nil : "MARKETING_VERSION=#{version}"),
      ].compact.join(" "),
    )

    next unless upload

    upload_to_testflight(
      api_key: key,
      ipa: "#{OUT}/copad.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true,
    )
  end

  lane :status do
    connect_api
    app = Spaceship::ConnectAPI::App.find(APP_ID)
    UI.user_error!("No App Store Connect record for #{APP_ID}") unless app
    Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 5).each do |b|
      UI.message("#{b.pre_release_version&.version} (#{b.version}) => #{b.processing_state}  uploaded=#{b.uploaded_date}")
    end
  end
end
