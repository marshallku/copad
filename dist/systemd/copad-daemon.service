[Unit]
Description=copad daemon (action registry, trigger engine, plugin supervisor)
Documentation=https://github.com/marshallku/copad
Documentation=file:%h/dev/copad/docs/harness-integration.md
# Wait for the user session so DBUS_SESSION_BUS_ADDRESS resolves and XDG_RUNTIME_DIR is
# mounted.
After=default.target

[Service]
Type=simple
# `COPADD_BIN_PATH` is rewritten at install time (scripts/install-dev.sh, install.sh) to the
# install location: systemd expands neither `~` nor `$HOME` here and has no specifier that
# picks between user and system install dirs.
ExecStart=COPADD_BIN_PATH
# Restart on crash but not on intentional `systemctl stop` (success).
Restart=on-failure
# 10s back-off lets a transient cause (socket path busy on rapid restart) settle and avoids
# tight restart loops on persistent config errors.
RestartSec=10
# Pump copadd info-level logs into the journal. Set RUST_LOG=debug
# in `systemctl --user edit copad-daemon` to override per-deployment.
Environment=RUST_LOG=info
# Deterministic PATH: the `systemd --user` instance otherwise inherits whatever the login
# session exported, which may lack ~/.local/bin and ~/.cargo/bin. The pilot plugin shells out
# to `csd`, which spawns `claude` + `tmux`. `%h` is the user's home.
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Pins the csd location so a PATH change cannot silently break dispatch. Override
# per-deployment via `systemctl --user edit`.
Environment=COPAD_PILOT_CSD_BIN=%h/.cargo/bin/csd
# Defense in depth against plugin fork-bombs landing through the supervisor.
LimitNOFILE=4096

[Install]
# `systemctl --user enable` creates the WantedBy symlink under
# ~/.config/systemd/user/default.target.wants/.
WantedBy=default.target
